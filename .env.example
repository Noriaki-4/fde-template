# Application
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:postgres@postgresql:5432/fde_poc

# Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-root
MINIO_USE_SSL=false

# Search (Phase 2+)
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_ENABLED=false

# Graph (Phase 3+)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_ENABLED=false

# RDF (Phase 3+)
RDF_MODEL=property_graph
RDF_ENGINE=neo4j
RDF_SPARQL_ENDPOINT=http://virtuoso:8890/sparql
RDF_ENABLED=false

# NoSQL (Phase 7+)
NOSQL_ENABLED=false
NOSQL_ENGINE=dynamodb
NOSQL_TABLE_NAME=fde-data
SCYLLADB_ENDPOINT=http://scylladb:8000
AWS_REGION=ap-northeast-1

# LLM (Phase 4+)
# Provider: ollama (local models) | bedrock (AWS Claude)
# Ollama models: gemma:4-e4b, qwen:7b, qwen:14b, mistral:7b, llama2:7b, etc.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=gemma:4-e4b
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
EMBEDDING_MODEL=bge-m3

# Frontend
BACKEND_URL=http://backend:8000
