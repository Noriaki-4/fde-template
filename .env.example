# Application
DEBUG=false
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgresql:5432/fde_poc

# Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-root
MINIO_USE_SSL=false

# Search (Phase 2+)
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_ENABLED=false

# Property Graph (Phase 3+) — independent from RDF, can enable both for hybrid graph
GRAPH_ENABLED=false
GRAPH_ENGINE=neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# RDF Graph (Phase 3+) — independent from Property Graph, can enable both for hybrid graph
RDF_ENABLED=false
RDF_ENGINE=virtuoso
RDF_SPARQL_ENDPOINT=http://virtuoso:8890/sparql

# NoSQL (Phase 7+)
NOSQL_ENABLED=false
NOSQL_ENGINE=dynamodb
NOSQL_TABLE_NAME=fde-data
SCYLLADB_ENDPOINT=http://scylladb:8000
AWS_REGION=ap-northeast-1

# LLM (Phase 4+)
# Provider: ollama (local models) | bedrock (AWS Claude)
# Ollama models: gemma:4-e4b, qwen:7b, qwen:14b, mistral:7b, llama2:7b, etc.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=gemma:4-e4b
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
EMBEDDING_MODEL=bge-m3

# Frontend
BACKEND_URL=http://backend:8000
